# Supabase project settings (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay test keys. Replace with live keys only at client launch.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your-test-key-secret
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-webhook-secret

# Displayed in Razorpay Checkout and customer-facing messages.
BUSINESS_NAME=FoodOG
SUPPORT_EMAIL=orders@example.com
